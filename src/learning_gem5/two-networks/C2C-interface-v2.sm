machine(MachineType:Interface, "Chip-to-Chip interface.")
    : 
    
      DirectoryMemory * interface;
      Cycles toMemLatency := 1;

                                           
    // IN
    MessageBuffer *outResponse, network="To", virtual_network="2",
          vnet_type="response";

    MessageBuffer *outForward, network="To", virtual_network="1",
          vnet_type="forward";

    // OUT
    MessageBuffer *inResponse, network="From", virtual_network="0",
          vnet_type="response";

    MessageBuffer *inRequest, network="From", virtual_network="2",
          vnet_type="request";
{

//   _____ _______    _______ ______  _____ 
//  / ____|__   __|/\|__   __|  ____|/ ____|
// | (___    | |  /  \  | |  | |__  | (___  
//  \___ \   | | / /\ \ | |  |  __|  \___ \ 
//  ____) |  | |/ ____ \| |  | |____ ____) |
// |_____/   |_/_/    \_\_|  |______|_____/ 

    //state_declaration(State, desc="Interface states",
    //                  default="C2CInterface_State_IDLE") {
    //    IDLE,       AccessPermission:Read_Write,       desc="Idle, waiting a for requests";
    //}

    state_declaration(State, desc="Interface states", defaut="Interface_State_IDLE") {
        IDLE,       AccessPermission:Read_Write,       desc="Idle, waiting a for requests";
    }
 // ________      ________ _   _ _______ _____ 
 //|  ____\ \    / /  ____| \ | |__   __/ ____|
 //| |__   \ \  / /| |__  |  \| |  | | | (___  
 //|  __|   \ \/ / |  __| | . ` |  | |  \___ \ 
 //| |____   \  /  | |____| |\  |  | |  ____) |
 //|______|   \/   |______|_| \_|  |_| |_____/ 

    enumeration(Event, desc="Interface events") {
        responseMsgIn,    desc="Response message on the input port";
        requestMsgIn,     desc="Request message on the input port";
    }

    structure(Entry, desc="...", interface="AbstractCacheEntry", main="false") {
        State InterfaceState,   desc="Directory state";
        NetDest Sharers,        desc="Sharers for this block";
        NetDest Owner,          desc="Owner of this block";
    }

    Tick clockEdge();

    Entry getInterfaceEntry(Addr addr), return_by_pointer = "yes" {
        Entry interface_entry := static_cast(Entry, "pointer", interface[addr]);
        if (is_invalid(interface_entry)) {
            // This first time we see this address allocate an entry for it.
            interface_entry := static_cast(Entry, "pointer",
                                     interface.allocate(addr, new Entry));
        }
        return interface_entry;
    }

    State getState(Addr addr) {
        if (interface.isPresent(addr)) {
            return getInterfaceEntry(addr).InterfaceState;
        } else {
            return State:IDLE;
        }
    }
        //return State:IDLE;
    //void setState(Addr addr, State state) {
    //    if (interface.isPresent(addr)) {
    //        DPRINTF(RubySlicc, "Owner %s\n", getInterfaceEntry(addr).Owner);
    //        assert(getInterfaceEntry(addr).Owner.count() == 1);
    //        assert(getInterfaceEntry(addr).Sharers.count() == 0);
    //        getInterfaceEntry(addr).InterfaceState := state;
    //    }
    //}

    void setState(Addr addr, State state) {
        getInterfaceEntry(addr).InterfaceState := state;
    }

    AccessPermission getAccessPermission(Addr addr) {
        if (interface.isPresent(addr)) {
            Entry e := getInterfaceEntry(addr);
            return Interface_State_to_permission(e.InterfaceState);
        } else  {
            return AccessPermission:NotPresent;
        }
    }
    void setAccessPermission(Addr addr, State state) {
        if (interface.isPresent(addr)) {
            Entry e := getInterfaceEntry(addr);
            e.changePermission(Interface_State_to_permission(state));
        }
    }

    void functionalRead(Addr addr, Packet *pkt) {
        functionalMemoryRead(pkt);
    }

    // This returns the number of writes. So, if we write then return 1
    int functionalWrite(Addr addr, Packet *pkt) {
        if (functionalMemoryWrite(pkt)) {
            return 1;
        } else {
            return 0;
        }
    }

//  _____   ____  _____ _______ _____ 
// |  __ \ / __ \|  __ \__   __/ ____|
// | |__) | |  | | |__) | | | | (___  
// |  ___/| |  | |  _  /  | |  \___ \ 
// | |    | |__| | | \ \  | |  ____) |
// |_|     \____/|_|  \_\ |_| |_____/ 

    out_port(response_out, ResponseMsg, outResponse);
    out_port(forward_out, RequestMsg, outForward);

    in_port(response_in, ResponseMsg, inResponse) {
        if (response_in.isReady(clockEdge())) {
            peek(response_in, ResponseMsg) {
                trigger(Event:responseMsgIn, in_msg.addr);
            }
        }
    }

    in_port(request_in, RequestMsg, inRequest) {
        if (request_in.isReady(clockEdge())) {
            peek(request_in, RequestMsg) {
                trigger(Event:requestMsgIn, in_msg.addr);    
            }
        }
    }

 //          _____ _______ _____ ____  _   _  _____ 
 //    /\   / ____|__   __|_   _/ __ \| \ | |/ ____|
 //   /  \ | |       | |    | || |  | |  \| | (___  
 //  / /\ \| |       | |    | || |  | | . ` |\___ \ 
 // / ____ \ |____   | |   _| || |__| | |\  |____) |
 ///_/    \_\_____|  |_|  |_____\____/|_| \_|_____/ 


    action(fwdResponse, "fwdResp", desc="Forwards the response message") {
        peek(response_in, ResponseMsg) {
            enqueue(response_out, ResponseMsg, 1) {
                out_msg.addr := address;
                //out_msg.Type := MemoryRequestType:MEMORY_READ;
                out_msg.Sender := machineID;
                out_msg.DataBlk := in_msg.DataBlk;
                //out_msg.MessageSize := MessageSizeType:Request_Control;
                //out_msg.Len := 0;
            }
        }
    }

    action(fwdRequest, "fwdReq", desc="Forwards the request message") {
        peek(request_in, RequestMsg) {
            enqueue(forward_out, RequestMsg, 1) {
                out_msg.addr := address;
                //out_msg.Type := MemoryRequestType:MEMORY_READ;
                out_msg.Requestor := in_msg.Requestor;
                out_msg.Destination := getInterfaceEntry(address).Owner;
                //out_msg.MessageSize := MessageSizeType:Request_Control;
                //out_msg.Len := 0;
            }
        }
    }

//  _______                  _ _   _                 
// |__   __|                (_) | (_)                
//    | |_ __ __ _ _ __  ___ _| |_ _  ___  _ __  ___ 
//    | | '__/ _` | '_ \/ __| | __| |/ _ \| '_ \/ __|
//    | | | | (_| | | | \__ \ | |_| | (_) | | | \__ \
//    |_|_|  \__,_|_| |_|___/_|\__|_|\___/|_| |_|___/


    transition(IDLE, responseMsgIn) {
        fwdResponse;
    }

    transition(IDLE, requestMsgIn) {
        fwdRequest;
    }

}