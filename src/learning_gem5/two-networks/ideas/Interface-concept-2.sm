// Define a new state machine
machine(MachineType:TwoNetworkControllerMSI, "Two Network Controller with MSI Cache")
    :

      InterfaceMemory * interface;
      Cycles toMemLatency := 1;

    // Forwarding messages from Network 1 to Network 0 
    MessageBuffer *toNetwork0, network="From", virtual_network="1",
        vnet_type="forward";
    
    MessageBuffer *fromNetwork0, network="To", virtual_network="1",
        vnet_type="forward";

    // Forwarding messages from Network 0 to Network 1
    MessageBuffer *toNetwork1, network="From", virtual_network="1",
        vnet_type="forward";
    
    MessageBuffer *fromNetwork1, network="To", virtual_network="1",
        vnet_type="forward";
    
    {
        // For the states below, we have to use the controller 
        // name and the name we use for states
        state_declaration(State, desc="Interface states", 
                          default="Interface_State_IDLE") {
            // Stable states
            IDLE,       AccessPermission:Read_Write, desc="Waiting for a request";
            REQ_FWD,    AccessPermission:Read_Write, desc="Forwarding a request";
            RESP_FWD,   AccessPermission:Read_Write, desc="Forwarding a response";
        }

        enumeration(Event, desc="Interface events") {
            // Message from Network 0 to Network 1
            from0to1, desc="Message comming from Network 0 to Network 1";
            // Message from Network 1 to Network 0
            from1to0, desc="Message comming from Network 0 to Network 1";
        }

        Tick clockEdge();
    /*************************************************************************/
    // Network ports
    // Out ports
    out_port(forward_out, RequestMsg, fromNetwork0);
    out_port(forward_out, RequestMsg, fromNetwork1);

    // In ports
    in_port(response_in, ResponseMsg, toNetwork0);
    in_port(response_in, ResponseMsg, toNetwork1);

    /*************************************************************************/
    // Actions






    state(REQ_FWD) {
        transition(PutM, WB);
        transition(GetS, RESP_FWD);
        transition(GetM, RESP_FWD);
    }

    state(RESP_FWD) {
        transition(DataResp, IDLE) {
            forwardResp;
        }
    }

    state(WB) {
        transition(WBAck, IDLE);
    }

    state__inactive(CACHE) {
        // Create an instance of the MSI Cache protocol
        MSICacheModule msi_cache;

        // Initialize the MSI Cache module
        init {
            msi_cache.init();
        }

        // Handle incoming messages
        transition(IDLE, Request) {
            msi_cache.handleRequest;
            if (msi_cache.responseIsValid) {
                sendResponseToReq;
            }
        }

        transition(IDLE, Inv) {
            msi_cache.handleInvalidation;
        }

        transition(IDLE, DataResp) {
            msi_cache.handleResponse;
        }

        transition(IDLE, PutM) {
            msi_cache.handlePutM;
        }

        // Handle internal events
        transition(IDLE, MSI_CACHE_FLUSH) {
            msi_cache.handleFlush;
        }

        transition(IDLE, MSI_CACHE_INVALIDATE) {
            msi_cache.handleCacheInvalidate;
        }

        // State transitions from the MSI Cache module
        transition(MSICacheModule::S_IDLE, MSICacheModule::S_WAIT) {
            sendGetS;
        }

        transition(MSICacheModule::S_IDLE, MSICacheModule::M_WAIT) {
            sendGetM;
        }

        transition(MSICacheModule::S_WAIT, IDLE) {
            if (msi_cache.responseIsValid) {
                sendResponseToReq;
            }
        }

        transition(MSICacheModule::M_WAIT, IDLE) {
            if (msi_cache.responseIsValid) {
                sendResponseToReq;
            }
        }
    }

    // Define actions for transitions
    action forwardResp() {
        sendResponseToReq;
        sendResponseToOtherNetwork;
    }

    // Define external functions for the controller
    external void sendResponseToOtherNetwork();
}

