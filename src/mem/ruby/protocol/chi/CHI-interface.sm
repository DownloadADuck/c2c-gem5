machine(MachineType:Interface, "C2C interface controller") :

  Cycles request_latency := 1;
  Cycles response_latency := 2;
  Cycles data_latency := 1;
  Cycles to_memory_controller_latency := 1;

  int data_channel_size;

  // Communicating with the network
  MessageBuffer * reqOut,   network="To", virtual_network="0", vnet_type="none";
  MessageBuffer * snpOut,   network="To", virtual_network="1", vnet_type="none";
  MessageBuffer * rspOut,   network="To", virtual_network="2", vnet_type="none";
  MessageBuffer * datOut,   network="To", virtual_network="3", vnet_type="response";

  MessageBuffer * reqIn,   network="From", virtual_network="0", vnet_type="none";
  MessageBuffer * snpIn,   network="From", virtual_network="1", vnet_type="none";
  MessageBuffer * rspIn,   network="From", virtual_network="2", vnet_type="none";
  MessageBuffer * datIn,   network="From", virtual_network="3", vnet_type="response";

  // Requests that can allocate a TBE
  MessageBuffer * reqRdy;
  MessageBuffer * c2cReqRdy;

  // C2c out port
  MessageBuffer * requestToC2c;
  MessageBuffer * responseFromC2c;

  // C2c in port
  MessageBuffer * requestFromC2c;
  MessageBuffer * responseToC2c;

  // Trigger queue for internal event
  MessageBuffer * triggerQueue;

{

  ////////////////////////////////////////////////////////////////////////////
  // States
  ////////////////////////////////////////////////////////////////////////////

  state_declaration(State, desc="Transaction states", default="Interface_State_READY") {
    // We don't know if the line is cached, so the memory copy is maybe stable
    READY, AccessPermission:Backing_Store, desc="Ready to transfer the line";

    // SNF states
    WAITING_NET_DATA, AccessPermission:Backing_Store_Busy, desc="Waiting data from the network";
    SENDING_NET_DATA, AccessPermission:Backing_Store_Busy, desc="Sending data to the network";
    READING_MEM, AccessPermission:Backing_Store_Busy, desc="Waiting data from c2c interface";

    // Interface states 
    BLKD_REQ, AccessPermission:Invalid, desc="Sending request to chip1 s network";
    SEND_CTRL_DATA, AccessPermission:Invalid, desc="Sending response data to chip0";
    WAIT_ACK, AccessPermission:Backing_Store_Busy,       desc="Waiting for a response CompAck after sending read data";
    WAIT_WBDATA, AccessPermission:Invalid, desc="Waiting for CBWrData_UC from Net";
    WAIT_COMP, AccessPermission:Invalid, desc="Waiting for CompDBID from Net";
    SENDING_WBDATA, AccessPermission:Invalid, desc="Sending CBWrData_UC to Net";
    SENDING_NET_DATA_NO_ACK, AccessPermission:Backing_Store_Busy, desc="Sending data to network, not waiting for Acks";

    SENDING_SNP_DATA, AccessPermission:Invalid, desc="Sending snoop data for snoop forwarding";
    BLKD_SNP, AccessPermission:Invalid, desc="Pending snoop transaction";
    SNP_FWD, AccessPermission:Invalid, desc="Special case for snoop forwarding";


    // Null state for debugging; allow writes
    null, AccessPermission:Backing_Store, desc="Null state";
  }


  ////////////////////////////////////////////////////////////////////////////
  // Events
  ////////////////////////////////////////////////////////////////////////////

  enumeration(Event, desc="Memory events") {
    // Checks if a request can allocate a TBE be moved to reqRdy
    CheckAllocTBE, desc="";
    CheckAllocTBE_WithCredit, desc="";

    // Checks if there is a request in the requestFromC2c
    CheckC2cReqAllocTBE, desc="";

    // Requests
    Net_ReadShared, desc="";
    C2c_ReadShared, desc="";
    Net_ReadUnique, desc="";
    C2c_ReadUnique, desc="";
    Net_CleanUnique, desc="";
    C2c_CleanUnique, desc="";
    Net_Evict, desc="";
    C2c_Evict, desc="";
    Net_WriteEvictFull, desc="";
    C2c_WriteEvictFull, desc="";

    // Snoops
    Net_SnpCleanInvalid, desc="";
    C2c_SnpCleanInvalid, desc="";
    Net_SnpSharedFwd, desc="";
    C2c_SnpSharedFwd, desc="";
    Net_SnpUniqueFwd, desc="";
    C2c_SnpUniqueFwd, desc="";

    // Data
    Net_CompData_UC, desc="Response data from net of type UC";
    C2c_CompData_UC, desc="Response data from c2c of type UC";
    Net_CompData_SC, desc="Response data from net of type SC";
    C2c_CompData_SC, desc="Response data from c2c of type SC";
    Net_CompData_SD_PD, desc="Response data from net of type SD PD";
    C2c_CompData_SD_PD, desc="Response data from c2c of type SD PD";
    Net_CompData_UD_PD, desc="Response data from net of type UD PD";
    C2c_CompData_UD_PD, desc="Response data from c2c of type UD PD";
    Net_CBWrData_UC, desc="Response from an evict";
    Net_CBWrData_UC_ReceiveDone, desc="Received all CBWrData_UC messages";
    C2c_CBWrData_UC, desc="";
    Net_SnpRespData_I_PD, desc="Response data to a snoop";
    C2c_SnpRespData_I_PD, desc="Response data to a snoop";
    Net_SnpRespData_SC_Fwded_SD_PD, desc="Response data to a snoop";
    C2c_SnpRespData_SC_Fwded_SD_PD, desc="Response data to a snoop";
    Net_SnpRespData_SC_Fwded_SC, desc="Response data to a snoop";
    C2c_SnpRespData_SC_Fwded_SC, desc="Response data to a snoop";

    // Responses
    Net_CompAck, desc="";
    C2c_CompAck, desc="";
    Net_Comp_I, desc="";
    C2c_Comp_I, desc="";
    Net_Comp_UC, desc="";
    C2c_Comp_UC, desc="";
    Net_CompDBIDResp, desc="";
    C2c_CompDBIDResp, desc="";

    Net_SnpResp_I, desc="";
    C2c_SnpResp_I, desc="";

    // Internal event triggers
    Trigger_Send, desc="";
    Trigger_SendDone, desc="";
    Trigger_ReceiveDataDone, desc="Received all read data";
    Trigger_SendRetry, desc="";
    Trigger_SendPCrdGrant, desc="";

    Trigger_SendToC2c_Request, desc="Trigger the sending of requests to c2c";
    Trigger_SendToNet_Request, desc="Trigger the sending of requests to net";
  }


  Event reqToEvent (CHIRequestType type) {
    if (type == CHIRequestType:ReadShared) {
      return Event:Net_ReadShared;
    } else if (type == CHIRequestType:ReadUnique) {
      return Event:Net_ReadUnique;
    } else if (type == CHIRequestType:CleanUnique) {
      return Event:Net_CleanUnique;
    } else if (type == CHIRequestType:Evict) {
      return Event:Net_Evict;
    } else if (type == CHIRequestType:WriteEvictFull) {
      return Event:Net_WriteEvictFull;
    } else {
      DPRINTF(RubyC2c, "reqToEvent CHIRequestType: %s\n", type);
      error("Invalid CHIRequestType");
    }
  }

  Event snpToEvent (CHIRequestType type) {
    if (type == CHIRequestType:SnpCleanInvalid) {
      return Event:Net_SnpCleanInvalid;
    } else if (type == CHIRequestType:SnpSharedFwd) {
      return Event:Net_SnpSharedFwd;
    } else if (type == CHIRequestType:SnpUniqueFwd) {
      return Event:Net_SnpUniqueFwd;
    } else {
      DPRINTF(RubyC2c, "snpToEvent CHIRequestType: %s\n", type);
      error("Invalid CHIRequestType snoop");
    }
  }

  Event rspToEvent (CHIResponseType type) {
    if (type == CHIResponseType:CompAck) {
      return Event:Net_CompAck;
    } else if (type == CHIResponseType:Comp_I) {
      return Event:Net_Comp_I;
    } else if (type == CHIResponseType:Comp_UC) {
      return Event:Net_Comp_UC;
    } else if (type == CHIResponseType:CompDBIDResp) {
      return Event:Net_CompDBIDResp;
    } else if (type == CHIResponseType:SnpResp_I) {
      return Event:Net_SnpResp_I;
    } else {
      DPRINTF(RubyC2c, "rspToEvent CHIResponseType: %s\n", type);
      error("Invalid CHIResponseType");
    }
  }

  Event datToEvent (CHIDataType type) {
    if (type == CHIDataType:CompData_UC) {
      return Event:Net_CompData_UC;
    } else if (type == CHIDataType:CompData_SC) {
      return Event:Net_CompData_SC;
    } else if (type == CHIDataType:CompData_SD_PD) {
      return Event:Net_CompData_SD_PD;
    } else if (type == CHIDataType:CompData_UD_PD) {
      return Event:Net_CompData_UD_PD;
    } else if (type == CHIDataType:CBWrData_UC) {
      return Event:Net_CBWrData_UC;
    } else if (type == CHIDataType:SnpRespData_I_PD) {
      return Event:Net_SnpRespData_I_PD;
    } else if (type == CHIDataType:SnpRespData_SC_Fwded_SD_PD) {
      return Event:Net_SnpRespData_SC_Fwded_SD_PD;
    } else if (type == CHIDataType:SnpRespData_SC_Fwded_SC) {
      return Event:Net_SnpRespData_SC_Fwded_SC;
    } else {
      DPRINTF(RubyC2c, "datToEvent CHIDataType: %s\n", type);
      error("Invalid CHIDataType");
    }
  }

  Event c2cReqToEvent (C2cRequestType type) {
    if (type == C2cRequestType:ReadShared) {
      return Event:C2c_ReadShared;
    } else if (type == C2cRequestType:ReadUnique) {
      return Event:C2c_ReadUnique;
    } else if (type == C2cRequestType:CleanUnique) {
      return Event:C2c_CleanUnique;
    } else if (type == C2cRequestType:Evict) {
      return Event:C2c_Evict;
    } else if (type == C2cRequestType:WriteEvictFull) {
      return Event:C2c_WriteEvictFull;
    } else if (type == C2cRequestType:SnpCleanInvalid) {
      return Event:C2c_SnpCleanInvalid;
    } else if (type == C2cRequestType:SnpSharedFwd) {
      return Event:C2c_SnpSharedFwd;
    } else if (type == C2cRequestType:SnpUniqueFwd) {
      return Event:C2c_SnpUniqueFwd;
    } else {
      DPRINTF(RubyC2c, "c2cReqToEvent C2cRequestType: %s\n", type);
      error("Invalid C2c request type");
    }
  }

  Event c2cRespToEvent (C2cRequestType type) {
    if (type == C2cRequestType:CompData_UC) {
      return Event:C2c_CompData_UC;
    } else if (type == C2cRequestType:CompData_SC) {
      return Event:C2c_CompData_SC;
    } else if (type == C2cRequestType:CompData_SD_PD) {
      return Event:C2c_CompData_SD_PD;
    } else if (type == C2cRequestType:CompData_UD_PD) {
      return Event:C2c_CompData_UD_PD;
    } else if (type == C2cRequestType:CBWrData_UC) {
      return Event:C2c_CBWrData_UC;
    } else if (type == C2cRequestType:CompAck) {
      return Event:C2c_CompAck;
    } else if (type == C2cRequestType:Comp_I) {
      return Event:C2c_Comp_I;
    } else if (type == C2cRequestType:Comp_UC) {
      return Event:C2c_Comp_UC;
    } else if (type == C2cRequestType:CompDBIDResp) {
      return Event:C2c_CompDBIDResp;
    } else if (type == C2cRequestType:SnpResp_I) {
      return Event:C2c_SnpResp_I;
    } else if (type == C2cRequestType:SnpRespData_I_PD) {
      return Event:C2c_SnpRespData_I_PD;
    } else if (type == C2cRequestType:SnpRespData_SC_Fwded_SD_PD) {
      return Event:C2c_SnpRespData_SC_Fwded_SD_PD;
    } else if (type == C2cRequestType:SnpRespData_SC_Fwded_SC) {
      return Event:C2c_SnpRespData_SC_Fwded_SC;
    } else {
      DPRINTF(RubyGenerated, "c2cRespToEvent C2cRequestType: %s\n", type);
      error("Invalid C2cResponseType");
    }
  }

  CHIRequestType c2cMsgToCHIReq(C2cRequestType type){
    if (type == C2cRequestType:ReadShared) {
      return CHIRequestType:ReadShared;
    } else if (type == C2cRequestType:ReadUnique) {
      return CHIRequestType:ReadUnique;
    } else if (type == C2cRequestType:CleanUnique) {
      return CHIRequestType:CleanUnique;
    } else if (type == C2cRequestType:Evict) {
      return CHIRequestType:Evict;
    } else if (type == C2cRequestType:WriteEvictFull) {
      return CHIRequestType:WriteEvictFull;
    } else if (type == C2cRequestType:SnpCleanInvalid) {
      return CHIRequestType:SnpCleanInvalid;
    } else if (type == C2cRequestType:SnpSharedFwd) {
      return CHIRequestType:SnpSharedFwd;
    } else if (type == C2cRequestType:SnpUniqueFwd) {
      return CHIRequestType:SnpUniqueFwd;
    } else {
      error("Unexpected C2cMsg request type");
    }
  }

  CHIResponseType c2cMsgToCHIRsp(C2cRequestType type) {
    if(type == C2cRequestType:CompDBIDResp) {
      return CHIResponseType:CompDBIDResp;
    } else if (type == C2cRequestType:CompAck) {
      return CHIResponseType:CompAck;
    } else if (type == C2cRequestType:Comp_I) {
      return CHIResponseType:Comp_I;
    } else if (type == C2cRequestType:Comp_UC) {
      return CHIResponseType:Comp_UC;
    } else if (type == C2cRequestType:SnpResp_I) {
      return CHIResponseType:SnpResp_I;
    } else {
      error ("Unexpected C2cMsg response type");
    }
  }

  CHIDataType c2cMsgToCHIData(C2cRequestType type) {
    if (type == C2cRequestType:CompData_UC) {
      return CHIDataType:CompData_UC;
    } else if (type == C2cRequestType:CompData_SC) {
      return CHIDataType:CompData_SC;
    } else if (type == C2cRequestType:CompData_SD_PD) {
      return CHIDataType:CompData_SD_PD;
    } else if (type == C2cRequestType:CompData_UD_PD) {
      return CHIDataType:CompData_UD_PD;
    } else if (type == C2cRequestType:CBWrData_UC) {
      return CHIDataType:CBWrData_UC;
    } else if (type == C2cRequestType:SnpRespData_I_PD) {
      return CHIDataType:SnpRespData_I_PD;
    } else if (type == C2cRequestType:SnpRespData_SC_Fwded_SD_PD) {
      return CHIDataType:SnpRespData_SC_Fwded_SD_PD;
    } else if (type == C2cRequestType:SnpRespData_SC_Fwded_SC) {
      return CHIDataType:SnpRespData_SC_Fwded_SC;
    } else {
      error("Unexpected C2cMsg data type");
    }
  }

  C2cRequestType CHIReqToC2cMsg(CHIRequestType type) {
    if (type == CHIRequestType:ReadShared) {
      return C2cRequestType:ReadShared;
    } else if (type == CHIRequestType:ReadUnique) {
      return C2cRequestType:ReadUnique;
    } else if (type == CHIRequestType:CleanUnique) {
      return C2cRequestType:CleanUnique;
    } else if (type == CHIRequestType:Evict) {
      return C2cRequestType:Evict;
    } else if (type == CHIRequestType:WriteEvictFull) {
      return C2cRequestType:WriteEvictFull;
    } else if (type == CHIRequestType:SnpCleanInvalid) {
      return C2cRequestType:SnpCleanInvalid;
    } else if (type == CHIRequestType:SnpSharedFwd) {
      return C2cRequestType:SnpSharedFwd;
    } else if (type == CHIRequestType:SnpUniqueFwd) {
      return C2cRequestType:SnpUniqueFwd;
    } else {
      error("Unexpected CHIRequest type");
    }
  }

  C2cRequestType CHIRspToC2cMsg(CHIResponseType type) {
    if (type == CHIResponseType:CompAck) {
      return C2cRequestType:CompAck;
    } else if (type == CHIResponseType:Comp_I) {
      return C2cRequestType:Comp_I;
    } else if (type == CHIResponseType:Comp_UC) {
      return C2cRequestType:Comp_UC;
    } else if (type == CHIResponseType:CompDBIDResp) {
      return C2cRequestType:CompDBIDResp;
    } else if (type == CHIResponseType:SnpResp_I) {
      return C2cRequestType:SnpResp_I;
    } else {
      error("Unexpected CHIResponse type");
    }
  }

  C2cRequestType CHIDatToC2cMsg(CHIDataType type) {
    if (type == CHIDataType:CompData_UC) {
      return C2cRequestType:CompData_UC;
    } else if (type == CHIDataType:CompData_SC) {
      return C2cRequestType:CompData_SC;
    } else if (type == CHIDataType:CompData_SD_PD) {
      return C2cRequestType:CompData_SD_PD;
    } else if (type == CHIDataType:CompData_UD_PD) {
      return C2cRequestType:CompData_UD_PD;
    } else if (type == CHIDataType:CBWrData_UC) {
      return C2cRequestType:CBWrData_UC;
    } else if (type == CHIDataType:SnpRespData_I_PD) {
      return C2cRequestType:SnpRespData_I_PD;
    } else if (type == CHIDataType:SnpRespData_SC_Fwded_SD_PD) {
      return C2cRequestType:SnpRespData_SC_Fwded_SD_PD;
    } else if (type == CHIDataType:SnpRespData_SC_Fwded_SC) {
      return C2cRequestType:SnpRespData_SC_Fwded_SC;
    } else {
      error("Unexpected CHIData type");
    }
  }

  ////////////////////////////////////////////////////////////////////////////
  // Data structures
  ////////////////////////////////////////////////////////////////////////////

  // Cache block size
  int blockSize, default="RubySystem::getBlockSizeBytes()";

  // Keeps track of the number of response data messages expected
  structure(ExpectedMap, external ="yes") {
    void clear(int dataChunks);
    void addExpectedRespType(CHIResponseType);
    void addExpectedDataType(CHIDataType);
    void setExpectedCount(int val);
    void addExpectedCount(int val);
    bool hasExpected();
    bool hasReceivedResp();
    bool hasReceivedData();
    int expected();
    int received();
    bool receiveResp(CHIResponseType);
    bool receiveData(CHIDataType);
    bool receivedDataType(CHIDataType);
    bool receivedRespType(CHIResponseType);
  }

  // TBE fields
  structure(TBE, desc="...") {
    int storSlot,   desc="Slot in the storage tracker occupied by this entry";
    Addr addr,      desc="Line address for this TBE";
    Addr accAddr,   desc="Original access address. Set only for Write*Ptl";
    int  accSize,   desc="Access size. Set only for Write*Ptl";
    State state,    desc="Current line state";
    DataBlock dataBlk, desc="Transaction data";
    WriteMask dataBlkValid, desc="valid bytes in dataBlk";
    int rxtxBytes, desc="Bytes sent or received";
    MachineID requestor, desc="Requestor that originated this request";
    MachineID destination, desc="Where we are sending data";
    bool useDataSepResp, desc="Replies with DataSepResp instead of CompData";

    MachineID c2c_sharers, desc="Stores the c2c_sharers when sending a response";
    bool retToSrc, desc="Stores the retToSrc for snoop handling";

    // Storing types
    CHIRequestType to_c2c_req_type, desc="Temporarily stores the request type";
    C2cRequestType to_net_req_type, desc="Temporarily stores the c2c request type";

    CHIRequestType to_c2c_snp_type, desc="Temporarily stores the snoop type";
    C2cRequestType to_net_snp_type, desc="Temporarily stores the c2c snoop type";

    CHIResponseType to_c2c_rsp_type, desc="Temporarily stores the net resp type";
    C2cRequestType to_net_rsp_type, desc="Temporarily stores the c2c resp type";

    CHIDataType snd_msgType, desc="used to send the right response data type";
    CHIDataType net_dat_type, desc="Temporatily store the net data type";

    // List of expected response and data. Checks the type of data against the
    // expected ones for debugging purposes
    ExpectedMap expected_req_resp, template="<CHIResponseType,CHIDataType>";
    CHIResponseType slicchack1; // fix compiler not including headers
    CHIDataType slicchack2; // fix compiler not including headers

    MachineID Sender, desc="Original request for this request";
    MessageSizeType size, desc="Message size";
  }

  structure(TBETable, external ="yes") {
    TBE lookup(Addr);
    void allocate(Addr);
    void deallocate(Addr);
    bool isPresent(Addr);
    bool areNSlotsAvailable(int n, Tick curTime);
  }

  structure(TBEStorage, external ="yes") {
    int size();
    int capacity();
    int reserved();
    int slotsAvailable();
    bool areNSlotsAvailable(int n);
    void incrementReserved();
    void decrementReserved();
    int addEntryToNewSlot();
    void removeEntryFromSlot(int slot);
  }

  TBETable TBEs, template="<Interface_TBE>", constructor="m_number_of_TBEs";
  TBEStorage storTBEs, constructor="this, m_number_of_TBEs";

  // Not needed now
  // Tracks all pending MemoryAcks (debug purposes only)
  //int pendingWrites, default="0";

  structure(TriggerMsg, desc="...", interface="Message") {
    Addr addr;
    Event event;
    MachineID retryDest;

    bool functionalRead(Packet *pkt) { return false; }
    bool functionalRead(Packet *pkt, WriteMask &mask) { return false; }
    bool functionalWrite(Packet *pkt) { return false; }
  }

  // Tracks a pending credit request from a retry
  structure(RetryQueueEntry) {
    Addr addr,           desc="Line address";
    MachineID retryDest, desc="Retry destination";
  }

  structure(TriggerQueue, external ="yes") {
    void pop();
    bool empty();
    void emplace(Addr,MachineID);
    RetryQueueEntry next();
  }

  TriggerQueue retryQueue, template="<Interface_RetryQueueEntry>";

  ////////////////////////////////////////////////////////////////////////////
  // External functions
  ////////////////////////////////////////////////////////////////////////////

  Tick clockEdge();
  Tick curTick();
  Tick cyclesToTicks(Cycles c);
  void set_tbe(TBE b);
  void unset_tbe();
  void wakeUpAllBuffers(Addr a);
  bool respondsTo(Addr addr);
  // Used by the requestor side
  MachineID mapAddressToDownstreamMachine(Addr addr);

  ////////////////////////////////////////////////////////////////////////////
  // Interface functions required by SLICC
  ////////////////////////////////////////////////////////////////////////////

  State getState(TBE tbe, Addr addr) {
    if (is_valid(tbe)) {
        assert(tbe.addr == addr);
        return tbe.state;
    } else {
        return State:READY;
    }
  }

  void setState(TBE tbe, Addr addr, State state) {
    if (is_valid(tbe)) {
      assert(tbe.addr == addr);
      tbe.state := state;
    }
  }

  AccessPermission getAccessPermission(Addr addr) {
    if (respondsTo(addr)) {
      TBE tbe := TBEs[addr];
      if (is_valid(tbe)) {
        DPRINTF(RubySlicc, "%x %s,%s\n", addr, tbe.state, Interface_State_to_permission(tbe.state));
        return Interface_State_to_permission(tbe.state);
      } else {
        // This might not work
        DPRINTF(RubySlicc, "%x %s\n", addr, AccessPermission:Invalid);
        return AccessPermission:Invalid;
      }
    } else {
      DPRINTF(RubySlicc, "%x %s\n", addr, AccessPermission:NotPresent);
      return AccessPermission:NotPresent;
    }
  }

  void setAccessPermission(Addr addr, State state) {
  }

  void functionalRead(Addr addr, Packet *pkt, WriteMask &mask) {
    if (respondsTo(addr)) {
      DPRINTF(RubySlicc, "functionalRead %x\n", addr);
      TBE tbe := TBEs[addr];

      if (mask.isEmpty()) {
        functionalMemoryRead(pkt);
        mask.fillMask();
        DPRINTF(RubySlicc, "functionalRead mem %x %s\n", addr, mask);
      }

      // Update with any transient data
      //TODO additional handling of partial data ??
      if (is_valid(tbe)) {
        WriteMask read_mask;
        read_mask.setMask(addressOffset(tbe.accAddr, tbe.addr), tbe.accSize);
        read_mask.andMask(tbe.dataBlkValid);
        if (read_mask.isEmpty() == false) {
          testAndReadMask(addr, tbe.dataBlk, read_mask, pkt);
          DPRINTF(RubySlicc, "functionalRead tbe %x %s %s %s\n", addr, tbe.dataBlk, read_mask, mask);
          mask.orMask(read_mask);
        }
      }
    }
  }

  int functionalWrite(Addr addr, Packet *pkt) {
    if(respondsTo(addr)) {
      int num_functional_writes := 0;
      TBE tbe := TBEs[addr];
      if (is_valid(tbe)) {
        num_functional_writes := num_functional_writes +
          testAndWrite(addr, tbe.dataBlk, pkt);
        DPRINTF(RubySlicc, "functionalWrite tbe %x %s\n", addr, tbe.dataBlk);
      }
      num_functional_writes := num_functional_writes + functionalMemoryWrite(pkt);
      DPRINTF(RubySlicc, "functionalWrite mem %x\n", addr);
      return num_functional_writes;
    } else {
      return 0;
    }
  }

  void clearRexpectedReqResp(TBE tbe) {
    assert(blockSize >= data_channel_size);
    assert((blockSize % data_channel_size) == 0);
    tbe.expected_req_resp.clear(blockSize / data_channel_size);
  }

  ////////////////////////////////////////////////////////////////////////////
  // Helper functions
  ////////////////////////////////////////////////////////////////////////////

  void printResources() {
    DPRINTF(RubySlicc, "Resources(avail/max): TBEs=%d/%d\n",
                  storTBEs.size(), storTBEs.capacity());
    DPRINTF(RubySlicc, "Resources(in/out size): rdy=%d req=%d/%d rsp=%d/%d dat=%d/%d snp=%d/%d\n",
                  reqRdy.getSize(curTick()),
                  reqIn.getSize(curTick()), reqOut.getSize(curTick()),
                  rspIn.getSize(curTick()), rspOut.getSize(curTick()),
                  datIn.getSize(curTick()), datOut.getSize(curTick()),
                  snpIn.getSize(curTick()), snpOut.getSize(curTick()));
  }

  ////////////////////////////////////////////////////////////////////////////
  // Input/output ports definitions
  ////////////////////////////////////////////////////////////////////////////

  // Outbound port definitions

  out_port(reqOutPort, CHIRequestMsg, reqOut);
  out_port(snpOutPort, CHIRequestMsg, snpOut);
  out_port(rspOutPort, CHIResponseMsg, rspOut);
  out_port(datOutPort, CHIDataMsg, datOut);
  // Internal queues
  out_port(triggerOutPort, TriggerMsg, triggerQueue);
  out_port(reqRdyOutPort, CHIRequestMsg, reqRdy);
  out_port(c2cReqRdyOutPort, C2cMsg, c2cReqRdy);
  // C2c requestor c2c_out_port
  out_port(requestToC2c_out, C2cMsg, requestToC2c);
  // C2c responder c2c_in_port
  out_port(responseToC2c_out, C2cMsg, responseToC2c);

  // Inbound port definitions

  // Response
  in_port(rspInPort, CHIResponseMsg, rspIn, rank=6) {
    if (rspInPort.isReady(clockEdge())) {
      printResources();
      peek(rspInPort, CHIResponseMsg) {
        trigger(rspToEvent(in_msg.type), in_msg.addr, TBEs[in_msg.addr]);
      }
    }
  }

  // Data from requestor if write request or from SNF if read
  in_port(datInPort, CHIDataMsg, datIn, rank=5) {
    if (datInPort.isReady(clockEdge())) {
      printResources();
      peek(datInPort, CHIDataMsg) {
        assert((in_msg.bitMask.count() <= data_channel_size)
                && (in_msg.bitMask.count() > 0));
        trigger(datToEvent(in_msg.type), in_msg.addr, TBEs[in_msg.addr]);
      }
    }
  }

  // Data/Ack from the repsonder
  in_port(responseFromC2c_in, C2cMsg, responseFromC2c, rank=4) {
    if (responseFromC2c_in.isReady(clockEdge())) {
      printResources();
      peek(responseFromC2c_in, C2cMsg) {
        Addr addr := makeLineAddress(in_msg.addr);
          trigger(c2cRespToEvent(in_msg.Type), in_msg.addr, TBEs[in_msg.addr]);
      }
    }
  }

  // Request from the C2C requestor
  in_port(requestFromC2c_in, C2cMsg, requestFromC2c, rank=4) {
    if (requestFromC2c_in.isReady(clockEdge())) {
      printResources();
      peek(requestFromC2c_in, C2cMsg) {
        Addr addr := makeLineAddress(in_msg.addr);
        trigger(Event:CheckC2cReqAllocTBE, addr, TBEs[addr]);
      }
    }
  }

   // Trigger
  in_port(triggerInPort, TriggerMsg, triggerQueue, rank=3) {
    if (triggerInPort.isReady(clockEdge())) {
      printResources();
      peek(triggerInPort, TriggerMsg) {
        trigger(in_msg.event, in_msg.addr, TBEs[in_msg.addr]);
      }
    }
  }

  // Snoops
  in_port(snpInPort, CHIRequestMsg, snpIn, rank=2) {
    if (snpInPort.isReady(clockEdge())) {
      printResources();
      peek(snpInPort, CHIRequestMsg) {
        trigger(snpToEvent(in_msg.type), in_msg.addr, TBEs[in_msg.addr]);
      }
    }
  }

  // Requests
  in_port(reqRdyInPort, CHIRequestMsg, reqRdy, rank=1) {
    if (reqRdyInPort.isReady(clockEdge())) {
      printResources();
      peek(reqRdyInPort, CHIRequestMsg) {
        trigger(reqToEvent(in_msg.type), in_msg.addr, TBEs[in_msg.addr]);
      }
    }
  }

  // Carefull about the ranks. Same ranks might cause an issue
  in_port(c2cReqRdyInPort, C2cMsg, c2cReqRdy, rank=1) {
    if(c2cReqRdyInPort.isReady(clockEdge())) {
      printResources();
      peek(c2cReqRdyInPort, C2cMsg) {
        trigger(c2cReqToEvent(in_msg.Type), in_msg.addr, TBEs[in_msg.addr]);
      }
    }
  }

  in_port(reqInPort, CHIRequestMsg, reqIn, rank=0) {
    if (reqInPort.isReady(clockEdge())) {
      printResources();
      peek(reqInPort, CHIRequestMsg) {
        if (in_msg.allowRetry) {
          trigger(Event:CheckAllocTBE, in_msg.addr, TBEs[in_msg.addr]);
        } else {
          // Only expected requests that do not allow retry are the ones that
          // are being retried after receiving credit
          trigger(Event:CheckAllocTBE_WithCredit,
                  in_msg.addr, TBEs[in_msg.addr]);
        }
      }
    }
  }



  ////////////////////////////////////////////////////////////////////////////
  // Actions
  ////////////////////////////////////////////////////////////////////////////

  action(checkAllocateTBE, desc="") {
    // Move to reqRdy if resources available, otherwise send retry
    if (storTBEs.areNSlotsAvailable(1)) {
      // reserve a slot for this request
      storTBEs.incrementReserved();

      peek(reqInPort, CHIRequestMsg) {
        enqueue(reqRdyOutPort, CHIRequestMsg, 0) {
          out_msg := in_msg;
        }
      }

    } else {
      peek(reqInPort, CHIRequestMsg) {
        assert(in_msg.allowRetry);
        enqueue(triggerOutPort, TriggerMsg, 0) {
          out_msg.addr := in_msg.addr;
          out_msg.event := Event:Trigger_SendRetry;
          out_msg.retryDest := in_msg.requestor;
          retryQueue.emplace(in_msg.addr,in_msg.requestor);
        }
      }
    }
    reqInPort.dequeue(clockEdge());
  }

  action(checkC2cReqAllocateTBE, desc="Check if we have resources, moves to c2cReqRdy") {
    if (storTBEs.areNSlotsAvailable(1)) {
      storTBEs.incrementReserved();

      peek(requestFromC2c_in, C2cMsg) {
        enqueue(c2cReqRdyOutPort, C2cMsg, 0) {
          out_msg := in_msg;
        }
      }

    } else {
      error("No retry yet implemented");
      peek(requestFromC2c_in, C2cMsg) {
        enqueue(triggerOutPort, TriggerMsg, 0) {
          out_msg.addr := in_msg.addr;
          out_msg.event := Event:Trigger_SendRetry;
          out_msg.retryDest := in_msg.Sender;
          retryQueue.emplace(in_msg.addr,in_msg.Sender);
        }
      }
    }
    requestFromC2c_in.dequeue(clockEdge());
  }

  action(checkAllocateTBE_withCredit, desc="") {
    // We must have reserved resources for this request
    peek(reqInPort, CHIRequestMsg) {
      assert(in_msg.allowRetry == false);
      enqueue(reqRdyOutPort, CHIRequestMsg, 0) {
        out_msg := in_msg;
      }
    }
    reqInPort.dequeue(clockEdge());
  }

  action(allocateTBE, "atbe", desc="Allocate TBEs for a miss") {
    // We must have reserved resources for this allocation
    storTBEs.decrementReserved();
    assert(storTBEs.areNSlotsAvailable(1));

    TBEs.allocate(address);
    set_tbe(TBEs[address]);
    tbe.storSlot := storTBEs.addEntryToNewSlot();
    tbe.addr := address;
    tbe.rxtxBytes := 0;
    tbe.useDataSepResp := false;
  }

  action(allocateTBE_Snoop, "atbes", desc="Allocate TBE for a snoop") {
    if (storTBEs.areNSlotsAvailable(1)) {
      // reserve a slot for this snoop request
      storTBEs.incrementReserved();
    } else {
      error("No TBE slots available for snoop request");
    }

    storTBEs.decrementReserved();
    assert(storTBEs.areNSlotsAvailable(1));

    TBEs.allocate(address);
    set_tbe(TBEs[address]);
    tbe.storSlot := storTBEs.addEntryToNewSlot();
    tbe.addr := address;
    tbe.rxtxBytes := 0;
    tbe.useDataSepResp := false;
  }

  action(c2cReqAllocateTBE, "c2catbe", desc="") {
    // We must have reserved resource for this allocation
    storTBEs.decrementReserved();
    assert(storTBEs.areNSlotsAvailable(1));

    TBEs.allocate(address);
    set_tbe(TBEs[address]);

    clearRexpectedReqResp(tbe);

    tbe.storSlot := storTBEs.addEntryToNewSlot();
    tbe.addr := address;
    tbe.rxtxBytes := 0;
    tbe.useDataSepResp := false;
  }

  action(initializeFromReqTBE, "itbe", desc="Initialize TBE fields") {
    peek(reqRdyInPort, CHIRequestMsg) {
      tbe.requestor := in_msg.requestor;
      if (in_msg.dataToFwdRequestor) {
        tbe.destination := in_msg.fwdRequestor;
      } else {
        tbe.destination := in_msg.requestor;
      }
      tbe.accAddr := in_msg.accAddr;
      tbe.accSize := in_msg.accSize;
      tbe.to_c2c_req_type := in_msg.type;
    }
  }

  action(initializeFromSnpTBE, "ifstbe", desc="Initialize TBE fields snoop") {
    peek(snpInPort, CHIRequestMsg) {
      tbe.requestor := in_msg.requestor;
      if (in_msg.type == CHIRequestType:SnpSharedFwd ||
          in_msg.type == CHIRequestType:SnpUniqueFwd) {
        tbe.destination := in_msg.fwdRequestor;
      } else {
        tbe.destination := in_msg.requestor;
      }
      tbe.accAddr := in_msg.accAddr;
      tbe.accSize := in_msg.accSize;
      tbe.to_c2c_snp_type := in_msg.type;
      tbe.c2c_sharers := in_msg.c2c_sharers;
      tbe.retToSrc := in_msg.retToSrc;
    }
  }

  action(initializeFromC2cReqTBE, "ic2ctbe", desc="Initialize TBE fields from C2C request") {
    peek(c2cReqRdyInPort, C2cMsg) {
      tbe.Sender := in_msg.Sender;
      tbe.size := in_msg.MessageSize;
      tbe.to_net_req_type := in_msg.Type;
    }
  }

  action(initializeFromC2cSnpTBE, "ic2csnp", desc="Initialize TBE fields from C2C snoop") {
    peek(requestFromC2c_in, C2cMsg) {
      tbe.Sender := in_msg.Sender;
      tbe.size := in_msg.MessageSize;
      tbe.to_net_snp_type := in_msg.Type;
      tbe.c2c_sharers := in_msg.C2c_sharers;
      tbe.retToSrc := in_msg.RetToSrc;
    }
  }

  action(deallocateTBE, "dtbe", desc="Deallocate TBEs") {
    assert(is_valid(tbe));
    storTBEs.removeEntryFromSlot(tbe.storSlot);
    TBEs.deallocate(address);
    unset_tbe();
    // send credit if requestor waiting for it
    if (retryQueue.empty() == false) {
      assert(storTBEs.areNSlotsAvailable(1));
      storTBEs.incrementReserved();
      RetryQueueEntry e := retryQueue.next();
      retryQueue.pop();
      enqueue(triggerOutPort, TriggerMsg, 0) {
        out_msg.addr := e.addr;
        out_msg.retryDest := e.retryDest;
        out_msg.event := Event:Trigger_SendPCrdGrant;
      }
    }
  }

  action(sendToC2c_Snoop, "stctcs", desc="Send snoop to c2c") {
    assert(is_valid(tbe));
    enqueue(requestToC2c_out, C2cMsg, to_memory_controller_latency) {
      out_msg.addr := tbe.addr;
      out_msg.Type := CHIReqToC2cMsg(tbe.to_c2c_snp_type);
      out_msg.Sender := tbe.requestor;
      out_msg.MessageSize := MessageSizeType:Request_Control;
      out_msg.C2c_sharers := tbe.c2c_sharers;
      out_msg.Len := 0;
      out_msg.RetToSrc := tbe.retToSrc;
    }
  } 

  action(sendToNet_Snoop, "stns", desc="Send snoop to net") {
    assert(is_valid(tbe));
    tbe.expected_req_resp.addExpectedDataType(CHIDataType:SnpRespData_I_PD); 
    tbe.expected_req_resp.addExpectedDataType(CHIDataType:SnpRespData_SC_Fwded_SD_PD); 
    tbe.expected_req_resp.addExpectedDataType(CHIDataType:SnpRespData_SC_Fwded_SC); 
    tbe.expected_req_resp.addExpectedDataType(CHIDataType:CompData_SD_PD); 
    tbe.expected_req_resp.addExpectedDataType(CHIDataType:CompData_SC);
    if (c2cMsgToCHIReq(tbe.to_net_snp_type) == CHIRequestType:SnpSharedFwd ||
        c2cMsgToCHIReq(tbe.to_net_snp_type) == CHIRequestType:SnpUniqueFwd) {
      tbe.expected_req_resp.addExpectedCount(3);
    } else {
      tbe.expected_req_resp.addExpectedCount(1);
    }
    enqueue(snpOutPort, CHIRequestMsg, request_latency) {
      out_msg.addr := tbe.addr;
      out_msg.accAddr := tbe.addr;
      out_msg.accSize := blockSize;
      out_msg.requestor := machineID;
      out_msg.fwdRequestor := machineID;
      out_msg.type := c2cMsgToCHIReq(tbe.to_net_snp_type);
      out_msg.allowRetry := false;
      out_msg.is_local_pf := false;
      out_msg.Destination.add(tbe.c2c_sharers);
      out_msg.retToSrc := tbe.retToSrc;
    }
  }

  action(trigger_SendToC2c_Request, "ts2cr", desc="Trigger sendToC2c_Request") {
    assert(is_valid(tbe));
    enqueue(triggerOutPort, TriggerMsg, 0) {
      out_msg.addr := address;
      out_msg.event := Event:Trigger_SendToC2c_Request;
    }
  }

  action(trigger_SendToNet_Request, "tsrr", desc="Trigger SentToNet_ReadShared") {
    assert(is_valid(tbe));
    enqueue(triggerOutPort, TriggerMsg, 0) {
      out_msg.addr := address;
      out_msg.event := Event:Trigger_SendToNet_Request;
    }
  }

  action(sendToC2c_Request, "stc2cr", desc="Send request to c2c") {
    assert(is_valid(tbe));
    enqueue(requestToC2c_out, C2cMsg, to_memory_controller_latency) {
      out_msg.addr := address;
      out_msg.Type := CHIReqToC2cMsg(tbe.to_c2c_req_type);
      out_msg.Sender := tbe.requestor;
      out_msg.MessageSize := MessageSizeType:Request_Control;
      out_msg.Len := 0;
    }
  }

  action(sendToNet_Request, "srr", desc="sends a request to the network") {
    assert(is_valid(tbe));
    tbe.expected_req_resp.addExpectedDataType(CHIDataType:CompData_UC);
    tbe.expected_req_resp.addExpectedDataType(CHIDataType:CompData_SC);
    tbe.expected_req_resp.addExpectedDataType(CHIDataType:CompData_SD_PD);
    tbe.expected_req_resp.addExpectedDataType(CHIDataType:CompData_UD_PD);
    tbe.expected_req_resp.addExpectedDataType(CHIDataType:CBWrData_UC);
    tbe.expected_req_resp.addExpectedCount(1);
    enqueue(reqOutPort, CHIRequestMsg, request_latency) {
      out_msg.addr := address;
      out_msg.accAddr := address;
      out_msg.accSize := blockSize;
      out_msg.type := c2cMsgToCHIReq(tbe.to_net_req_type);
      out_msg.requestor := machineID;
      out_msg.fwdRequestor := machineID;
      out_msg.isSeqReqValid := true;
      out_msg.is_local_pf := false;
      out_msg.allowRetry := true;
      out_msg.is_remote_pf := false;
      out_msg.Destination.add(mapAddressToDownstreamMachine(address));
    }

  }

  action(prepareSend_Data, "ps", desc="Copies received memory data to TBE") {
    assert(is_valid(tbe));
    peek(responseFromC2c_in, C2cMsg) {
      tbe.dataBlk := in_msg.DataBlk;
      tbe.snd_msgType := c2cMsgToCHIData(in_msg.Type);
    }
    tbe.rxtxBytes := 0;
    //tbe.dataBlkValid.setMask(addressOffset(tbe.accAddr, tbe.addr), tbe.accSize);
  }

  action(copyDataToTBE, "cpRDat", decs="Copies the received read data to TBE") {
    peek(datInPort, CHIDataMsg) {
      assert(is_valid(tbe));
      tbe.dataBlk.copyPartial(in_msg.dataBlk, in_msg.bitMask);
      tbe.dataBlkValid.orMask(in_msg.bitMask);
      tbe.rxtxBytes := tbe.rxtxBytes + in_msg.bitMask.count();
      tbe.net_dat_type := in_msg.type;
      // updating requestor for CompAcks
      tbe.requestor := in_msg.responder;
    }
  }

  action(sendToNet_Data, "sd", desc="Send received data to requestor") {
    assert(is_valid(tbe));
    assert(tbe.rxtxBytes < blockSize);
    enqueue(datOutPort, CHIDataMsg, data_latency) {
      out_msg.addr := tbe.addr;
      out_msg.type := tbe.snd_msgType;
      out_msg.dataBlk := tbe.dataBlk;
      // Called in order for the whole block so use rxtxBytes as offset
      out_msg.bitMask.setMask(tbe.rxtxBytes, data_channel_size);
      if (out_msg.type == CHIDataType:SnpRespData_SC_Fwded_SD_PD || 
          out_msg.type == CHIDataType:SnpRespData_SC_Fwded_SC) {
        out_msg.Destination.add(tbe.requestor);
      } else {
        out_msg.Destination.add(tbe.destination);
      }
      out_msg.responder := machineID;
    }

    //DPRINTF(RubySlicc, "rxtxBytes=%d\n", tbe.rxtxBytes);

    tbe.rxtxBytes := tbe.rxtxBytes + data_channel_size;

    // end or send next chunk next cycle
    Event next := Event:Trigger_SendDone;
    Cycles delay := intToCycles(0);
    if (tbe.rxtxBytes < blockSize) {
        next := Event:Trigger_Send;
        delay := intToCycles(1);
    }
    enqueue(triggerOutPort, TriggerMsg, delay) {
      out_msg.addr := address;
      out_msg.event := next;
    }
  }

  action(checkForReceiveCompletion, "crrc", desc="Check if all read data is received") {
    assert(is_valid(tbe));
    DPRINTF(RubySlicc, "rxtxBytes=%d\n", tbe.rxtxBytes);
    assert(tbe.expected_req_resp.hasExpected());

    peek(datInPort, CHIDataMsg) {
      // Decrement pending
      if (tbe.expected_req_resp.receiveData(in_msg.type) == false) {
        error("Received unexpected message");
      }
      if (tbe.dataBlkValid.isFull() == false) {
        // clear mask if started to receive new data
        if(tbe.dataBlkValid.isFull()){
          tbe.dataBlkValid.clear();
        }
      } else {
        enqueue(triggerOutPort, TriggerMsg, 0) {
          out_msg.addr := address;
          if (in_msg.type == CHIDataType:CBWrData_UC) {
            out_msg.event := Event:Net_CBWrData_UC_ReceiveDone;
          } else {
            out_msg.event := Event:Trigger_ReceiveDataDone;
          }
        }
      }
    }
  }

  action(sendToC2c_Data, "stc2cd", desc="Sends data to c2c") {
    assert(is_valid(tbe));
    enqueue(responseToC2c_out, C2cMsg, to_memory_controller_latency) {
      out_msg.addr := tbe.addr;
      out_msg.Type := CHIDatToC2cMsg(tbe.net_dat_type);
      out_msg.Sender := tbe.requestor;
      out_msg.MessageSize := MessageSizeType:Response_Data;
      out_msg.DataBlk := tbe.dataBlk;
      out_msg.Len := tbe.accSize;
    }
    tbe.dataBlkValid.clear();
  }

  action(sendToC2c_CompAck, "s2cca", desc="Send CompAck to C2c") {
    peek(rspInPort, CHIResponseMsg) {
      enqueue(responseToC2c_out, C2cMsg, response_latency) {
        out_msg.addr := address;
        out_msg.Type := C2cRequestType:CompAck;
        out_msg.MessageSize := MessageSizeType:Response_Control;
        out_msg.C2c_sharers := in_msg.responder;
      }
    }
  }
  
  action(sendToNet_CompAck, "s2nca", desc="Send back CompAck to network") {
    peek(responseFromC2c_in, C2cMsg) {
      enqueue(rspOutPort, CHIResponseMsg, response_latency) {
        out_msg.addr := address;
        out_msg.type := CHIResponseType:CompAck;
        out_msg.responder := machineID;
        // adding the c2c_sharer 
        out_msg.c2c_sharers := in_msg.C2c_sharers;
        out_msg.Destination.add(mapAddressToDownstreamMachine(address));
        DPRINTF(RubyGenerated, "SendToNet_Response CompAck c2c_Sharers: %s\n", out_msg.c2c_sharers);
      }
    }
  }

  action(sendToC2c_CompDBIDResp, "s2ccdr", desc="Send CompDBIDResp to C2c") {
    enqueue(responseToC2c_out, C2cMsg, response_latency) {
      out_msg.addr := address;
      out_msg.Type := C2cRequestType:CompDBIDResp;
      out_msg.MessageSize := MessageSizeType:Response_Control;
    }
  }

  action(prepareSend_Response, "psr", desc="Saves info to tbe to send the response") {
    assert(is_valid(tbe));
    peek(responseFromC2c_in, C2cMsg){
      tbe.to_net_rsp_type := in_msg.Type;
    }
  }

  action(sendToC2c_Response, "c2cr", desc="Sends response to c2c") {
    assert(is_valid(tbe));
    enqueue(responseToC2c_out, C2cMsg, response_latency) {
      out_msg.addr := tbe.addr;
      out_msg.Type := CHIRspToC2cMsg(tbe.to_c2c_rsp_type);
      out_msg.MessageSize := MessageSizeType:Response_Control;
      out_msg.C2c_sharers := tbe.c2c_sharers;
      DPRINTF(RubyGenerated, "SendToC2c_Response C2c_Sharers: %s\n", out_msg.C2c_sharers);
    }
  }

  //action(sendToNet_CompDBIDResp, "s2ncdr", desc="Send CompDBID to network") {
  //  assert(is_valid(tbe));
  //  clearRexpectedReqResp(tbe);
  //  tbe.expected_req_resp.addExpectedDataType(CHIDataType:CBWrData_UC);
  //  tbe.expected_req_resp.addExpectedCount(1);
  //  enqueue(rspOutPort, CHIResponseMsg, response_latency) {
  //    out_msg.addr := tbe.addr;
  //    out_msg.type := CHIResponseType:CompDBIDResp;
  //    out_msg.responder := machineID;
  //    out_msg.Destination.add(tbe.requestor);
  //  }
  //}

  action(sendToNet_Response, "s2nrsp", desc="Send response to the network") {
    assert(is_valid(tbe));
    clearRexpectedReqResp(tbe);
    tbe.expected_req_resp.addExpectedDataType(CHIDataType:CBWrData_UC);
    tbe.expected_req_resp.addExpectedCount(1);
    enqueue(rspOutPort, CHIResponseMsg, response_latency) {
      out_msg.addr := tbe.addr;
      out_msg.type := c2cMsgToCHIRsp(tbe.to_net_rsp_type);
      out_msg.responder := machineID;
      out_msg.Destination.add(tbe.requestor);
    }
  }

  //action(sendToC2c_CBWrData_UC, "s2cnwd", desc="Sending the WBData to C2C") {
  //  assert(is_valid(tbe));
  //  enqueue(responseToC2c_out, C2cMsg, to_memory_controller_latency) {
  //    out_msg.addr := tbe.addr;
  //    out_msg.Type := C2cRequestType:CBWrData_UC;
  //    out_msg.Sender := tbe.requestor;
  //    out_msg.MessageSize := MessageSizeType:Response_Data;
  //    out_msg.DataBlk := tbe.dataBlk;
  //    out_msg.Len := tbe.accSize;
  //  }
  //  tbe.dataBlkValid.clear();
  //}

  action(updateTBE_FromNetResp, "utbefr", desc="Updates the TBE with response info") {
    assert(is_valid(tbe));
    peek(rspInPort, CHIResponseMsg) {
      tbe.to_c2c_rsp_type := in_msg.type;
      tbe.destination := in_msg.responder;
      tbe.c2c_sharers := in_msg.responder;
    }
  }

  action(updateTBE_FromC2cResp, "utbefc2cr", desc="Update the TBE with response from c2c") {
    assert(is_valid(tbe));
    peek(responseFromC2c_in, C2cMsg) { 
      tbe.to_net_rsp_type := in_msg.Type;
      tbe.c2c_sharers := in_msg.C2c_sharers;
    }
  }

  action(popReqInQueue, "preq", desc="Pop request queue.") {
    reqRdyInPort.dequeue(clockEdge());
  }

  action(popSnpInQueue, "psnp", desc="Pop snoop queue.") {
    snpInPort.dequeue(clockEdge());
  }

  action(popC2cReqRdyInQueue, "pcreq", decs="Pop c2c request queue.") {
    c2cReqRdyInPort.dequeue(clockEdge());
  }

  action(popDataInQueue, "pdata", desc="Pop data queue.") {
    datInPort.dequeue(clockEdge());
  }

  action(popRspInQueue, "presp", desc="Pop resp queue.") {
    rspInPort.dequeue(clockEdge());
  }

  action(popTriggerQueue, "ptrigger", desc="Pop trigger queue.") {
    triggerInPort.dequeue(clockEdge());
  }

  action(popResponseFromC2cQueue, "pmem", desc="Pop memory queue.") {
    responseFromC2c_in.dequeue(clockEdge());
  }

  // Not used but we keep it for when needed
  action(popRequestFromC2cQueue, "prfc2c", desc="Pop request from c2c queue.") {
    requestFromC2c_in.dequeue(clockEdge());
  }

  // Stall/wake-up only used for requests that arrive when we are on the
  // WAITING_NET_DATA state. For all other case the line should be either
  // ready or we can overlap
  action(stallRequestQueue, "str", desc="Stall and wait on the address") {
    peek(reqRdyInPort, CHIRequestMsg){
      stall_and_wait(reqRdyInPort, address);
    }
  }
  action(wakeUpStalled, "wa", desc="Wake up any requests waiting for this address") {
    wakeUpAllBuffers(address);
  }

  action(sendRetryAck, desc="") {
    peek(triggerInPort, TriggerMsg) {
      enqueue(rspOutPort, CHIResponseMsg, response_latency) {
        out_msg.addr := in_msg.addr;
        out_msg.type := CHIResponseType:RetryAck;
        out_msg.responder := machineID;
        out_msg.Destination.add(in_msg.retryDest);
      }
    }
  }

  action(sendPCrdGrant, desc="") {
    peek(triggerInPort, TriggerMsg) {
      enqueue(rspOutPort, CHIResponseMsg, response_latency) {
        out_msg.addr := in_msg.addr;
        out_msg.type := CHIResponseType:PCrdGrant;
        out_msg.responder := machineID;
        out_msg.Destination.add(in_msg.retryDest);
      }
    }
  }

  ////////////////////////////////////////////////////////////////////////////
  // Transitions
  ////////////////////////////////////////////////////////////////////////////

  // Requests
  transition(READY, {Net_Evict, Net_WriteEvictFull, Net_CleanUnique}, WAIT_COMP) {
    allocateTBE;
    initializeFromReqTBE;
    trigger_SendToC2c_Request;
    popReqInQueue;
  }

  transition(READY, {C2c_Evict, C2c_WriteEvictFull}) {
    c2cReqAllocateTBE;
    initializeFromC2cReqTBE;
    trigger_SendToNet_Request;
    popC2cReqRdyInQueue;
  }

  transition(READY, {Net_ReadShared, Net_ReadUnique}, READING_MEM) {
    allocateTBE;
    initializeFromReqTBE;
    trigger_SendToC2c_Request;
    popReqInQueue;
  }

  transition({READING_MEM, WAIT_COMP}, Trigger_SendToC2c_Request) {
    sendToC2c_Request;
    popTriggerQueue;
  }

  transition(READY, {C2c_ReadShared, C2c_ReadUnique, C2c_CleanUnique}, BLKD_REQ){
    c2cReqAllocateTBE;
    initializeFromC2cReqTBE;
    trigger_SendToNet_Request;
    popC2cReqRdyInQueue;
  }

  transition({BLKD_REQ, READY}, Trigger_SendToNet_Request) {
    sendToNet_Request;
    popTriggerQueue;
  }

  // Responses
  transition(READY, Net_CompAck) {
    updateTBE_FromNetResp;
    sendToC2c_Response;
    popRspInQueue;
    deallocateTBE;
  }

  transition(READY, C2c_CompAck) {
    updateTBE_FromC2cResp;
    sendToNet_CompAck;
    popResponseFromC2cQueue;
    deallocateTBE;
  }

  // waits for resp data so we don't deallocate TBE
  transition(READY, Net_CompDBIDResp) {
    updateTBE_FromNetResp;
    sendToC2c_Response;
    popRspInQueue;
  }

  // doesn't wait for resp, we deallocate TBE
  transition(READY, Net_Comp_I) {
    updateTBE_FromNetResp;
    sendToC2c_Response;
    deallocateTBE;
    popRspInQueue;
  }

  // Waits for CompAck
  transition(WAIT_COMP, C2c_Comp_UC, READY) {
    updateTBE_FromC2cResp;
    sendToNet_Response;
    popResponseFromC2cQueue;
  }

  transition(BLKD_SNP, Net_SnpResp_I, READY) {
    updateTBE_FromNetResp;
    sendToC2c_Response;
    deallocateTBE;
    popRspInQueue;
  }

  transition(BLKD_SNP, C2c_SnpResp_I, READY) {
    updateTBE_FromC2cResp;
    sendToNet_Response;
    deallocateTBE;
    popResponseFromC2cQueue;
  }

  transition(WAIT_COMP, C2c_Comp_I) {
    updateTBE_FromC2cResp;
    sendToNet_Response;
    popResponseFromC2cQueue;
  }

  transition(WAIT_COMP, C2c_CompDBIDResp, WAIT_WBDATA) {
    updateTBE_FromC2cResp;
    sendToNet_Response;
    popResponseFromC2cQueue;
  }

  // Waiting for Ack
  transition(BLKD_REQ, Net_Comp_UC, READY) {
    updateTBE_FromNetResp;
    sendToC2c_Response;
    popRspInQueue;
  }

  // Snoops
  transition(READY, Net_SnpCleanInvalid, BLKD_SNP) {
    allocateTBE_Snoop;
    initializeFromSnpTBE;
    sendToC2c_Snoop;
    popSnpInQueue;
  }

  transition(READY, C2c_SnpCleanInvalid, BLKD_SNP) {
    c2cReqAllocateTBE;
    initializeFromC2cSnpTBE;
    sendToNet_Snoop;
    popC2cReqRdyInQueue;
  }

  transition(READY, {Net_SnpSharedFwd, Net_SnpUniqueFwd}, SNP_FWD) {
    allocateTBE_Snoop;
    initializeFromSnpTBE;
    sendToC2c_Snoop;
    popSnpInQueue;
  }

  transition(READY, {C2c_SnpSharedFwd, C2c_SnpUniqueFwd}, SNP_FWD) {
    c2cReqAllocateTBE;
    initializeFromC2cSnpTBE;
    sendToNet_Snoop;
    popC2cReqRdyInQueue;
  }

  // Data
  transition(WAIT_WBDATA, Net_CBWrData_UC) {
    copyDataToTBE;
    checkForReceiveCompletion;
    popDataInQueue;
  }

  transition(WAIT_WBDATA, Net_CBWrData_UC_ReceiveDone, READY) {
    sendToC2c_Data;
    deallocateTBE;
    popTriggerQueue;
  }

  transition(READY, C2c_CBWrData_UC, SENDING_WBDATA) {
    prepareSend_Data;
    sendToNet_Data;
    popResponseFromC2cQueue;
  }

  transition(SENDING_WBDATA, Trigger_Send) {
    sendToNet_Data;
    popTriggerQueue;
  }

  transition(SENDING_WBDATA, Trigger_SendDone, READY) {
    deallocateTBE;
    wakeUpStalled;
    popTriggerQueue;
  }

  // Going back to the SNPFWD to send the complete data
  transition(READY, {Net_SnpRespData_SC_Fwded_SD_PD, Net_SnpRespData_SC_Fwded_SC}, BLKD_SNP) {
    copyDataToTBE;
    checkForReceiveCompletion;
    popDataInQueue;
  }

  transition({BLKD_REQ, BLKD_SNP, SNP_FWD}, {Net_CompData_UC, Net_CompData_SC, 
              Net_CompData_SD_PD, Net_CompData_UD_PD, Net_SnpRespData_SC_Fwded_SD_PD,
              Net_SnpRespData_SC_Fwded_SC}) {
    copyDataToTBE;
    checkForReceiveCompletion;
    popDataInQueue;
  }

  transition({READING_MEM, BLKD_SNP, SNP_FWD}, {C2c_CompData_UC, C2c_CompData_SC, 
              C2c_CompData_SD_PD, C2c_CompData_UD_PD}, 
              SENDING_NET_DATA) {
    prepareSend_Data;
    sendToNet_Data;
    popResponseFromC2cQueue;
  }
  
  transition(SENDING_NET_DATA, Trigger_Send) {
    sendToNet_Data;
    popTriggerQueue;
  }

  transition(SENDING_NET_DATA, Trigger_SendDone, READY) {
    wakeUpStalled;
    popTriggerQueue;
  }

  // SnpSharedFwd
  transition(READY, {C2c_SnpRespData_SC_Fwded_SD_PD, C2c_SnpRespData_SC_Fwded_SC}, SENDING_SNP_DATA) {
    prepareSend_Data;
    sendToNet_Data;
    popResponseFromC2cQueue;
  }
  
  transition(SENDING_SNP_DATA, Trigger_Send) {
    sendToNet_Data;
    popTriggerQueue;
  }

  transition(SENDING_SNP_DATA, Trigger_SendDone, SNP_FWD) {
    wakeUpStalled;
    popTriggerQueue;
  }

  // Data response that doesn't wait for Acks -> deallocateTBE
  transition({BLKD_REQ, SNP_FWD}, Trigger_ReceiveDataDone, READY) {
    sendToC2c_Data;
    wakeUpStalled;
    popTriggerQueue;
  }

  transition(BLKD_SNP, Net_SnpRespData_I_PD) {
    copyDataToTBE;
    checkForReceiveCompletion;
    popDataInQueue;
  }

  // Special case when we send both the compData and snpRespData
  //transition(READY, Net_SnpRespData_SC_Fwded_SD_PD, BLKD_SNP) {
  //  copyDataToTBE;
  //  checkForReceiveCompletion;
  //  popDataInQueue;
  //}

  transition(BLKD_SNP, Trigger_ReceiveDataDone, READY) {
    sendToC2c_Data;
    wakeUpStalled;
    deallocateTBE;
    popTriggerQueue;
  }

  transition(BLKD_SNP, C2c_SnpRespData_I_PD, SENDING_NET_DATA_NO_ACK) {
    prepareSend_Data;
    sendToNet_Data;
    popResponseFromC2cQueue;
  }
  // Sending loop not waiting for acks. Deallocating TBE in the end.
  transition(SENDING_NET_DATA_NO_ACK, Trigger_Send) {
    sendToNet_Data;
    popTriggerQueue;
  }

  transition(SENDING_NET_DATA_NO_ACK, Trigger_SendDone, READY) {
    wakeUpStalled;
    deallocateTBE;
    popTriggerQueue;
  }

  // Notice we only use this here and call wakeUp when leaving this state
  transition({READING_MEM,WAITING_NET_DATA,SENDING_NET_DATA},
             {Net_ReadShared}) {
    stallRequestQueue;
  }

  transition({READING_MEM,WAITING_NET_DATA,SENDING_NET_DATA,READY},
              Trigger_SendRetry) {
    sendRetryAck;
    popTriggerQueue;
  }

  transition({READING_MEM,WAITING_NET_DATA,SENDING_NET_DATA,READY},
              Trigger_SendPCrdGrant) {
    sendPCrdGrant;
    popTriggerQueue;
  }

  transition({READING_MEM,WAITING_NET_DATA,SENDING_NET_DATA,BLKD_REQ,READY},
              CheckAllocTBE) {
    checkAllocateTBE;
  }

  transition({BLKD_REQ,READY}, CheckC2cReqAllocTBE) {
    checkC2cReqAllocateTBE;
  }

  transition({READING_MEM,WAITING_NET_DATA,SENDING_NET_DATA,READY},
              CheckAllocTBE_WithCredit) {
    checkAllocateTBE_withCredit;
  }

}
