
// C2cRequestType used in C2cMsg

enumeration(C2cRequestType, desc="...") {

  // Southbound request: from directory to memory cache
  // or directory to memory or memory cache to memory
  MEMORY_WB,       desc="Write back data to memory";

  // response from memory to directory
  // (These are currently unused!)
  MEMORY_DATA, desc="Data read from memory";
  MEMORY_ACK,  desc="Write to memory acknowledgement";

  // C2C handshake messages
  ReqAck, desc="Controller is ready to receive a request";
  
  // Requests
  ReadShared, desc="ReadShared";
  ReadOnce, desc="ReadOnce";
  ReadUnique, desc="ReadUnique";
  CleanUnique, desc="CleanUnique";
  Evict, desc="Evict";
  WriteEvictFull, desc="WriteEvictFull";
  WriteUniqueFull, desc="WriteUniqueFull";
  WriteBackFull, desc="WriteBackFull";
  // Snoops
  SnpCleanInvalid, desc="SnpCleanInvalid";
  SnpUnique, desc="SnpUnique";
  SnpSharedFwd, desc="SnpSharedFwd";
  SnpUniqueFwd, desc="SnpUniqueFwd";
  SnpOnceFwd, desc="SnpOnceFwd";
  // Responses
  CompAck,    desc="CompAck";
  CompDBIDResp, desc="CompDBIDResp";
  RetryAck, desc="RetryAck";
  PCrdGrant, desc="PCrdGrant";

  Comp_I, desc="Comp_I";
  Comp_UC, desc="Comp_UC";
  SnpResp_I, desc="SnpResp_I";
  SnpResp_I_Fwded_UD_PD, desc="SnpResp_I_Fwded_UD_PD";
  SnpResp_I_Fwded_UC, desc="SnpResp_I_Fwded_UC";
  SnpResp_SC_Fwded_SC, desc="SnpResp_SC_Fwded_SC";
  SnpResp_SC_Fwded_SD_PD, desc="SnpResp_SC_Fwded_SD_PD";
  SnpResp_SD_Fwded_I, desc="SnpResp_SD_Fwded_I";
  SnpResp_SC_Fwded_I, desc="SnpResp_SC_Fwded_I";
  SnpResp_UD_Fwded_I, desc="SnpResp_UD_Fwded_I";
  SnpResp_UC_Fwded_I, desc="SnpResp_UC_Fwded_I";
  //Data
  NCBWrData, desc="NCBWrData";
  CBWrData_UC, desc="CBWrData_UC";
  CBWrData_SC, desc="CBWrData_SC";
  CBWrData_I, desc="CBWrData_I";
  CBWrData_SD_PD, desc="CBWrData_SP_PD";
  CBWrData_UD_PD, desc="CBWrData_UD_PD";
  CompData_UC, desc="CompData_UC";
  CompData_I, desc="CompData_UC";
  CompData_SC, desc="CompData_SC";
  CompData_SD_PD, desc="CompData_SD_PD";
  CompData_UD_PD, desc="CompData_UD_PD";
  SnpRespData_I_PD, desc="SnpRespData_I_PD";
  SnpRespData_I , desc="SnpRespData_I";
  SnpRespData_SC_PD , desc="SnpRespData_SC_PD";
  SnpRespData_SC , desc="SnpRespData_SC";
  SnpRespData_SD , desc="SnpRespData_SD";
  SnpRespData_UC , desc="SnpRespData_UC";
  SnpRespData_UD , desc="SnpRespData_UD";
  SnpRespData_SC_Fwded_SD_PD, desc="SnpRespData_SC_Fwded_SD_PD";
  SnpRespData_SC_Fwded_SC, desc="SnpRespData_SC_Fwded_SC";
  SnpRespData_SC_PD_Fwded_SC, desc="SnpRespData_SC_PD_Fwded_SC";
  SnpRespData_I_Fwded_SD_PD, desc="SnpRespData_I_Fwded_SC_PD";
  SnpRespData_I_PD_Fwded_SC, desc="SnpRespData_I_PD_Fwded_SC";
  SnpRespData_I_Fwded_SC, desc="SnpRespData_I_Fwded_SC";
}

// Message to and from C2C interface

structure(C2cMsg, desc="...", interface="Message") {
  Addr addr,                    desc="Physical address for this request";
  C2cRequestType Type,          desc="Type of memory request (MEMORY_READ or MEMORY_WB)";
  MachineID Sender,             desc="What component sent the data";
  MachineID OriginalRequestorMachId, desc="What component originally requested";
  MachineID Requestor,          desc="Request initiator";
  MachineID FwdRequestor,       desc="Destination for forwarded data";
  MachineID Responder,          desc="Responder that sent the response msg";

  // C2c sharer field
  MegaNetDest C2c_sharers,      desc="Off-chip sharer";
  MachineID C2c_requestor,      desc="Off-chip requestor";

  bool RetToSrc,                desc="Affects whether or not a snoop resp return data";
  bool Stale,                   desc="Response stale status flag";
  bool ReqAck,                  desc="This message is a request to send a request";
  bool AllowRetry,              desc="allowRetry field";
  bool Priority,                desc="This request has the priority";
  bool DataToFwdRequestor,      desc="Indicated that data needs forwarding";

  Addr AccAddr,                 desc="Original access address. Set for Write*Ptl and requests from the sequencer";
  int AccSize,                  desc="Access size. Set for Write*Ptl and requests from the sequencer";

  DataBlock DataBlk,            desc="Data to writeback";
  WriteMask BitMask,            desc="Which bytes in the data block are valid";
  MessageSizeType MessageSize,  desc="size category of the message";
  int Len,                      desc="size of the memory/dma request";

  // Not all fields used by all protocols:
  PrefetchBit Prefetch,         desc="Is this a prefetch request";
  bool ReadX,                   desc="Exclusive";
  int Acks,                     desc="How many acks to expect";
  RequestPtr SeqReq,        default="nullptr", desc="Pointer to original request from CPU/sequencer (nullptr if not valid)";
  bool IsSeqReqValid,       default="false",   desc="Set if seqReq is valid (not nullptr)";

  bool Is_local_pf,         desc="Request generated by a local prefetcher";
  bool Is_remote_pf,        desc="Request generated a prefetcher in another cache";

  bool UsesTxnId,       desc="True if using a Transaction ID", default="false";
  Addr TxnId,           desc="Transaction ID", default="0";

  bool functionalRead(Packet *pkt) {
    if ((MessageSize == MessageSizeType:Response_Data) ||
        (MessageSize == MessageSizeType:Writeback_Data))  {
      return testAndRead(addr, DataBlk, pkt);
    }
    return false;
  }

  bool functionalRead(Packet *pkt, WriteMask &mask) {
    if ((MessageSize == MessageSizeType:Response_Data) ||
        (MessageSize == MessageSizeType:Writeback_Data))  {
      WriteMask read_mask;
      read_mask.setMask(addressOffset(addr, makeLineAddress(addr)), Len, true);
      if (MessageSize != MessageSizeType:Writeback_Data) {
        read_mask.setInvertedMask(mask);
      }
      if (read_mask.isEmpty()) {
        return false;
      } else if (testAndReadMask(addr, DataBlk, read_mask, pkt)) {
        mask.orMask(read_mask);
        return true;
      }
    }
    return false;
  }

  bool functionalWrite(Packet *pkt) {
    return testAndWrite(addr, DataBlk, pkt);
  }
}
